// =============================================================================
// CheckMate — Prisma schema v4
//
// 對齊 CheckMate「Expense Case Review Prototype」（docs/product/product-scope.md 壹）
// 與 specs/review-case.md：
//   - 案件、費用明細、憑證（展示用模擬憑證）
//   - 審查紀錄：每次分析新增一筆，含四個面向的檢核結果、發現項目與當次憑證快照
//   - 人工流程動作：對最新審查紀錄完成初審或退回補件，原始建議不變
//   - 稽核軌跡：hash chain 串接
//
// v4 為重構後的新基準（schema v3 的 M1 Review Copilot 模型已整套替換，
// 舊 migration 封存於 git 歷史 tag era-m1-final）。
//
// 治理保證（append-only、理由必填、只處理最新審查紀錄…）寫在
// migrations/*_governance/migration.sql，說明見 migrations/GOVERNANCE_SQL.md。
// enum 值必須與 packages/shared/src/domain/vocabulary.ts 一一對應（enum-parity 測試）。
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

/// 處理進度：待處理 / 待補件 / 已完成初審
enum CaseStatus {
  PENDING
  AWAITING_INFO
  REVIEW_COMPLETED
}

/// 案件層級的審查建議：建議通過 / 建議補件 / 建議人工審核
enum Recommendation {
  APPROVE
  REQUEST_INFO
  MANUAL_REVIEW
}

/// 四個審查面向
enum ReviewDimension {
  EVIDENCE_MATCH
  CORPORATE_POLICY
  COMPLIANCE
  RISK_SIGNAL
}

/// 檢核結果：通過 / 未通過 / 無法判斷 / 不適用
enum CheckStatus {
  PASS
  FAIL
  UNDETERMINED
  NOT_APPLICABLE
}

/// 發現項目性質：可補正的缺漏 / 已確認的異常 / 系統無法判斷
enum FindingKind {
  MISSING
  ANOMALY
  UNDETERMINED
}

/// 本輪人工流程動作（ESCALATE 待對應 Slice 收斂後加入）
enum WorkflowAction {
  PROCEED
  REQUEST_INFO
}

enum ActorType {
  AGENT
  HUMAN
  SYSTEM
}

/// PRESET = 預置的模擬分析結果，不是引擎實際算出的
enum ReviewSource {
  PRESET
}

enum AuditEventType {
  CASE_CREATED
  REVIEW_RECORDED
  WORKFLOW_ACTION
  RECEIPT_READING
}

/// 一次單據讀取的結果（specs/receipt-reading.md）
enum ReadingOutcome {
  SUCCEEDED
  FAILED
}

// =============================================================================
// 案件
// =============================================================================

model ExpenseCase {
  id         String     @id @default(cuid())
  /// "EXP-2026-001"，對外識別（URL、搜尋、關聯案件）
  caseNumber String     @unique
  /// 處理進度。由人工流程動作推進，與動作在同一交易內更新。
  status     CaseStatus @default(PENDING)

  applicantName String
  employeeId    String?
  department    String
  category      String
  amount        Decimal   @db.Decimal(14, 2)
  /// 本輪只支援 TWD（DB CHECK 保證）
  currency      String    @default("TWD")
  expenseDate   DateTime  @db.Date
  /// 申請日期
  submittedAt   DateTime? @db.Date
  /// 列表「申報項目」欄
  summary       String
  description   String
  paymentMethod String?
  /// 展示情境名稱（模擬資料用）
  scenario      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       ExpenseLine[]
  receipts    Receipt[]
  reviews     ReviewRecord[]
  actions     WorkflowActionRecord[]
  auditEvents AuditEvent[]
  readings    ReceiptReading[]

  @@index([status])
}

/// 費用明細。單筆費用的案件也有一列，讓前端不必分兩種資料形狀。
model ExpenseLine {
  id      String      @id @default(cuid())
  caseId  String
  case    ExpenseCase @relation(fields: [caseId], references: [id])
  lineNo  Int
  /// "L008-1"；單筆案件沿用案件編號
  lineKey String

  category    String
  description String
  expenseDate DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  /// 未提供時為 null，不由總額反推
  netAmount   Decimal? @db.Decimal(14, 2)
  taxAmount   Decimal? @db.Decimal(14, 2)

  receipts ExpenseLineReceipt[]

  @@unique([caseId, lineNo])
  @@unique([caseId, lineKey])
}

/// 憑證。本輪為展示用模擬憑證（Fixture），不是真實文件或 OCR 結果。
model Receipt {
  id         String      @id @default(cuid())
  caseId     String
  case       ExpenseCase @relation(fields: [caseId], references: [id])
  /// "EV-001"
  receiptKey String      @unique

  vendor    String
  amount    Decimal  @db.Decimal(14, 2)
  issueDate DateTime @db.Date
  hasTaxId  Boolean
  /// 模擬憑證圖檔在前端 public 下的路徑
  imagePath String?

  createdAt DateTime @default(now())

  lines   ExpenseLineReceipt[]
  reviews ReviewReceipt[]
}

model ExpenseLineReceipt {
  lineId    String
  line      ExpenseLine @relation(fields: [lineId], references: [id])
  receiptId String
  receipt   Receipt     @relation(fields: [receiptId], references: [id])

  @@id([lineId, receiptId])
}

// =============================================================================
// 審查紀錄（append-only）
// =============================================================================

/// 每次分析產生一筆，不覆蓋前一次（specs/review-case.md 5.7）。
model ReviewRecord {
  id        String      @id @default(cuid())
  caseId    String
  case      ExpenseCase @relation(fields: [caseId], references: [id])
  /// 案件內的第幾次審查，最大者為最新
  seq       Int
  /// "REV-001-2"
  reviewKey String      @unique

  reviewedAt     DateTime
  recommendation Recommendation
  source         ReviewSource
  /// 引擎版本；預置資料為 null
  engineVersion  String?

  createdAt DateTime @default(now())

  checks   CheckResult[]
  findings Finding[]
  receipts ReviewReceipt[]
  action   WorkflowActionRecord?

  @@unique([caseId, seq])
}

/// 當次審查時已提供的憑證快照。歷史紀錄不能顯示後來補入的附件。
model ReviewReceipt {
  reviewId  String
  review    ReviewRecord @relation(fields: [reviewId], references: [id])
  receiptId String
  receipt   Receipt      @relation(fields: [receiptId], references: [id])

  @@id([reviewId, receiptId])
}

/// 單一面向的檢核結果。每筆審查紀錄四個面向各一筆。
model CheckResult {
  id        String          @id @default(cuid())
  reviewId  String
  review    ReviewRecord    @relation(fields: [reviewId], references: [id])
  dimension ReviewDimension
  status    CheckStatus
  summary   String

  @@unique([reviewId, dimension])
}

/// 需要使用者注意的問題。每個 Finding 必須能回溯到判斷依據（DB CHECK 保證）。
model Finding {
  id         String       @id @default(cuid())
  reviewId   String
  review     ReviewRecord @relation(fields: [reviewId], references: [id])
  /// 審查紀錄內的識別，用來比較兩次審查的新增與已解決問題
  findingKey String
  orderIndex Int

  dimension         ReviewDimension
  kind              FindingKind
  title             String
  explanation       String
  ruleCode          String?
  ruleText          String
  /// [["申請金額", "NT$1,680"], ...]
  comparison        Json            @default("[]")
  /// 疑似重複時被比較的既有案件
  relatedCaseNumber String?
  /// 對案件下一步的影響
  nextStep          String?

  @@unique([reviewId, findingKey])
  @@unique([reviewId, orderIndex])
}

// =============================================================================
// 人工流程動作與稽核（append-only）
// =============================================================================

/// 人工對最新審查紀錄的處理。一筆審查紀錄只處理一次（reviewId unique）。
/// 原始建議另存快照，不改寫審查紀錄。
model WorkflowActionRecord {
  id       String       @id @default(cuid())
  caseId   String
  case     ExpenseCase  @relation(fields: [caseId], references: [id])
  reviewId String       @unique
  review   ReviewRecord @relation(fields: [reviewId], references: [id])

  action                 WorkflowAction
  actorType              ActorType
  actorLabel             String
  /// 補件內容或審核說明，原樣保存
  reason                 String
  originalRecommendation Recommendation
  resultingStatus        CaseStatus
  /// 批次完成時同一批的識別
  batchId                String?

  createdAt DateTime @default(now())

  @@index([caseId])
}

/// hash = sha256(prevHash || caseId || seq || type || payload || createdAt)
model AuditEvent {
  id     String      @id @default(cuid())
  caseId String
  case   ExpenseCase @relation(fields: [caseId], references: [id])
  /// 案件內單調遞增，缺號即代表遭刪除
  seq    Int

  type       AuditEventType
  actorType  ActorType
  actorLabel String
  payload    Json

  prevHash String?
  hash     String

  createdAt DateTime @default(now())

  @@unique([caseId, seq])
  @@index([caseId, createdAt])
}

// =============================================================================
// 單據讀取（specs/receipt-reading.md，append-only）
//
// 開始讀取時寫一筆 ReceiptReading，結束時寫一筆 ReceiptReadingOutcome。
// 「讀取中」由「還沒有 outcome」推得，兩張表都不需要 UPDATE。
// 讀取結果不改變審查紀錄、檢查清單與處理進度。
// =============================================================================

model ReceiptReading {
  id     String      @id @default(cuid())
  caseId String
  case   ExpenseCase @relation(fields: [caseId], references: [id])

  actorType  ActorType
  actorLabel String

  /// 讀取服務與模型（例如 gemini / gemini-3.8-flash），以及讀取指示的版本
  provider      String
  model         String
  promptVersion String
  /// 送出的憑證：[{ receiptKey, sha256 }]
  inputs        Json

  startedAt DateTime @default(now())

  outcome ReceiptReadingOutcome?

  @@index([caseId, startedAt])
}

model ReceiptReadingOutcome {
  id        String         @id @default(cuid())
  readingId String         @unique
  reading   ReceiptReading @relation(fields: [readingId], references: [id])

  outcome       ReadingOutcome
  /// 每張憑證的模型原始回應：[{ receiptKey, text }]；失敗時可能只有部分或沒有
  rawResponses  Json           @default("[]")
  /// 成功時：{ [receiptKey]: ReceiptExtraction }
  extractions   Json?
  /// 成功時：以讀取金額計算的 E-01 結果 [{ lineKey, result }]
  amountChecks  Json?
  /// 失敗時的原因（顯示給使用者）
  failureReason String?
  /// 讀取服務回報的用量，供估算費用
  usage         Json?

  finishedAt DateTime @default(now())
}
